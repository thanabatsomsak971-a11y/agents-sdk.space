rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidAgent(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.model is string && data.model.size() <= 100 &&
             (!('voice' in data) || (data.voice is string && data.voice.size() <= 50)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50));
    }

    function isValidSession(data) {
      return data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 128 &&
             (!('model' in data) || (data.model is string && data.model.size() <= 100)) &&
             (!('turnsCount' in data) || data.turnsCount is number);
    }

    function isValidUserProfile(data) {
      return data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming());
      allow delete: if isOwner(userId);
    }

    // Agents Collection
    match /agents/{agentId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidAgent(incoming());
      allow update: if isSignedIn() &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidAgent(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Sessions Collection
    match /sessions/{sessionId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidSession(incoming());
      allow update: if isSignedIn() &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSession(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
